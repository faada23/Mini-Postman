<Window x:Class="Mini_Postman.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="Mini_Postman" Height="500" Width="700"
            Background="#1E1E1E">
    
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
            <Grid>
                
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Background="#3C3C3C" Margin="10,10,0,0" >
                    
                <ComboBox 
                          MinWidth="80" 
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          Style="{StaticResource DarkComboBox}"
                >
                    <ComboBoxItem>Get</ComboBoxItem>
                    <ComboBoxItem>Post</ComboBoxItem>
                    <ComboBoxItem>Put</ComboBoxItem>
                    <ComboBoxItem>Delete</ComboBoxItem>
                </ComboBox>
                </Border>
                
                <TextBox
                    Grid.Column="1"
                    Padding="5"
                    Margin="0,10,0,0"
                    VerticalContentAlignment="Center"
                    Background="#3C3C3C"
                    BorderBrush="#DDDDDD"
                    Foreground="#D4D4D4"
                    BorderThickness="0"
                    Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                ></TextBox>
                
                
                <Button
                    Command="{Binding SendRequestCommand}"
                    Margin="10,10,10,0"
                    Grid.Column="2"
                    BorderThickness="0"
                    MinWidth="80"           
                    Background="#007ACC"    
                    Foreground="#D4D4D4"
                    Cursor="Hand"           
                    Content="SEND">
                </Button>
               
            </Grid> 
        
        <TextBox Grid.Row="1" 
                 Grid.ColumnSpan="3"      
                 Margin="10,15,10,10" 
                 Background="#3E3E42"     
                 Foreground="#D4D4D4"     
                 Text="JSON Response will be here..."></TextBox>
    </Grid>
</Window>